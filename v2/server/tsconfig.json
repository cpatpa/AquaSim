{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "..",
    "sourceMap": false,
    "declaration": false,
    "esModuleInterop": true,
    "paths": {
      "#shared/*": ["../shared/*"]
    }
  },
  "include": ["src", "../shared"]
}
