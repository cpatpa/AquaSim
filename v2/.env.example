# AquaSim Environment Configuration
# Copy to .env and fill in values (or use the guided installer)

# Application
APP_URL=https://aquasim.example.com
CORS_ORIGIN=https://aquasim.example.com

# Database
DB_PASSWORD=CHANGE_ME_RANDOM_PASSWORD

# Authentication
JWT_SECRET=CHANGE_ME_RANDOM_SECRET
SAVE_SIGNING_KEY=CHANGE_ME_RANDOM_SAVE_KEY

# Cloudflare Tunnel (leave empty for local-only access)
TUNNEL_TOKEN=

# GitHub Webhook (optional, for auto-deploy)
GITHUB_WEBHOOK_SECRET=

# Email (leave empty to disable password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Build info (set automatically by deploy scripts)
GIT_COMMIT=dev
BUILD_TIME=unknown
